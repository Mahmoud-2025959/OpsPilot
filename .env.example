# OpsPilot - local service credentials (plan, "Compose Docker").
#
# Copy this file to .env and replace the values. .env is deliberately git-ignored: it holds the
# same class of secret as appsettings and must never be committed. The values here are the
# placeholder ones compose falls back to; the SQL Server password has no fallback and must be
# set, because the image refuses to start without one.

# Password for the SQL Server SA account. At least eight characters, drawn from three of
# upper / lower / digit / symbol.
SA_PASSWORD=Change_me_123!

# RabbitMQ credentials. Left at the image defaults, the guest account only works from localhost,
# which is the intended local case. Change these to match a shared deployment.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Optional Redis password. Leave empty for a passwordless local instance.
REDIS_PASSWORD=

# The key that signs and verifies access tokens. The application refuses to start without it.
# In development it comes from appsettings.Development.json; in a deployment set it here.
# Generate one with: openssl rand -base64 32
JWT__SIGNINGKEY=

# The key that encrypts the stored copy of an ingestion key (AES-256-GCM). The application
# refuses to start without it. In development it comes from appsettings.Development.json; in a
# deployment set it here. Generate one with: openssl rand -base64 32
APIKEYENCRYPTION__KEY=

# Optional. Comma-separated base64 keys that are still accepted for decryption but no longer
# used to encrypt. Set this to the old key when replacing APIKEYENCRYPTION__KEY, so the keys
# stored under the old one stay readable; drop it again once they have been rotated.
APIKEYENCRYPTION__PREVIOUSKEYS=

