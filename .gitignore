# Build output
bin/
obj/
buildcheck/
build/
*.user
*.binlog
msbuild.binlog

# Test results and ad-hoc run logs
TestResults/
*.trx

# Local webhook receiver output (scripts/webhook-receiver.ps1 writes it beside the repo root)
/webhook-receiver.log

# Scratch logs written while building and testing (testrun_*.txt, build_*.txt and the
# one-off probes copied beside them). Kept in the repository root, never committed.
/testrun_*.txt
/build_*.txt
/buildrun.txt
/buildcheck.txt
/restore*.txt
/rmqprobe.txt
/migration_*.txt
/pkcs_fix*.txt
/.tmp_test.txt

# Local secrets - never commit these. The compose credentials live in .env, and it is also
# where a developer puts the SMTP and RabbitMQ password overrides. The development secrets
# that the application insists on (the token signing key and the ingestion-key encryption
# key) sit in appsettings.Development.json: they are throwaway development values, and a
# deployment supplies its own through the environment instead.
.env
*.env
!*.env.example

# Tooling scratch
.vs/
.vscode/
.idea/
*.swp
