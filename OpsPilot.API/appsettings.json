{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=OpsPilot;Integrated Security=true"
  },
  "Jwt": {
    "Issuer": "OpsPilot",
    "Audience": "OpsPilot.Client",
    "SigningKey": "",
    "DurationInMinutes": 15,
    "RefreshTokenDays": 7
  },
  "ApiKeyEncryption": {
    "Key": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "OpsPilot.API"
    }
  },
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "UserName": "",
    "Password": "",
    "From": "",
    "FromName": "OpsPilot"
  },
  "EmailDispatch": {
    "Enabled": true,
    "Interval": "00:00:30",
    "BatchSize": 25,
    "MaxAttempts": 5
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "",
    "UseTls": false,
    "ExchangeName": "opspilot.events",
    "DeadLetterExchangeName": "opspilot.events.dlx",
    "DeadLetterQueueName": "opspilot.events.dead",
    "PublishTimeout": "00:00:10"
  },
  "Hangfire": {
    "Enabled": false,
    "DashboardEnabled": true,
    "DashboardPath": "/jobs",
    "SlaSweepCron": "* * * * *",
    "OutboxDrainCron": "*/30 * * * * *",
    "EmailDispatchCron": "*/30 * * * * *",
    "MaxAutomaticRetries": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}