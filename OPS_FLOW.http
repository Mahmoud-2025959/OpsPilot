### OPS_FLOW - OpsPilot E2E flow (VS Code REST Client)
#
# HOW TO RUN
#   1. Start the API:  dotnet run --project OpsPilot.API --launch-profile http
#   2. Send the requests top-to-bottom, in order. Each request has a # @name so later
#      requests can read the id/token out of its response:
#         {{login.response.body.$.data.accessToken}}
#   3. Registering a tenant only works once per slug/email. On a later run either change
#      @companySlug / @ownerEmail below, or skip step 1 and start at step 2 (Login).
#
# The API wraps every payload in { "succeeded", "code", "data", ... }, hence the
# "$.data" in every capture below.

@baseUrl = http://localhost:5093

@ownerEmail = owner@acme.test
@ownerPassword = Sup3rSecret!
@companyName = Acme Demo
@companySlug = acme-demo

###
### 1) REGISTER TENANT (Company + Owner) - AllowAnonymous
# @name registerTenant
POST {{baseUrl}}/api/v1/auth/register-tenant
Content-Type: application/json

{
  "companyName": "{{companyName}}",
  "slug": "{{companySlug}}",
  "email": "{{ownerEmail}}",
  "displayName": "Acme Owner",
  "password": "{{ownerPassword}}",
  "confirmPassword": "{{ownerPassword}}"
}

###
### 2) LOGIN - AllowAnonymous
# @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "identifier": "{{ownerEmail}}",
  "password": "{{ownerPassword}}"
}

###
### 3) REFRESH TOKEN - AllowAnonymous
# @name refresh
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.$.data.refreshToken}}"
}

###
### 4) GET CURRENT USER
# @name getMe
GET {{baseUrl}}/api/v1/users/me
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Accept: application/json

###
### 5) PERMISSIONS, ROLES, TENANT
GET {{baseUrl}}/api/v1/permissions
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###

GET {{baseUrl}}/api/v1/roles
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###

GET {{baseUrl}}/api/v1/tenant
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###
### 6) USERS - create an Engineer, then list
# @name createUser
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "email": "engineer@acme.test",
  "displayName": "Engineer One",
  "password": "Sup3rSecret!",
  "confirmPassword": "Sup3rSecret!",
  "roles": ["Engineer"]
}

###

GET {{baseUrl}}/api/v1/users?page=1&pageSize=20
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###
### 7) TEAMS - create, then add the Engineer
# @name createTeam
POST {{baseUrl}}/api/v1/teams
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "name": "Platform",
  "description": "Platform Team"
}

###

POST {{baseUrl}}/api/v1/teams/{{createTeam.response.body.$.data}}/members
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "userId": "{{createUser.response.body.$.data}}",
  "role": "Lead"
}

###
### 8) SERVICES - create, then read it back
# @name createService
POST {{baseUrl}}/api/v1/services
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "name": "API Gateway",
  "environment": "Production",
  "slug": "api-gateway",
  "description": "Main gateway",
  "repositoryUrl": "https://github.com/acme/api-gateway",
  "ownerTeamId": "{{createTeam.response.body.$.data}}"
}

###

GET {{baseUrl}}/api/v1/services/{{createService.response.body.$.data}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###
### 9) SLA POLICIES - read, then update
GET {{baseUrl}}/api/v1/sla-policies
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###

PUT {{baseUrl}}/api/v1/sla-policies
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "policies": [
    { "severity": "Critical", "responseMinutes": 15, "resolutionMinutes": 60 },
    { "severity": "High", "responseMinutes": 30, "resolutionMinutes": 120 },
    { "severity": "Medium", "responseMinutes": 60, "resolutionMinutes": 240 },
    { "severity": "Low", "responseMinutes": 120, "resolutionMinutes": 480 }
  ]
}

###
### 10) WEBHOOKS - register a local receiver before any incident exists
# Use a receiver you control: `scripts\webhook-receiver.ps1` (localhost:5099),
# webhook.site, or any echo server. Deliveries are staged when an incident event is stored.
# @name createWebhook
POST {{baseUrl}}/api/v1/webhooks
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "url": "http://localhost:5099/webhook"
}

###
### 11) INCIDENTS - create, assign, transition, comment, read timeline
# @name createIncident
POST {{baseUrl}}/api/v1/incidents
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "serviceId": "{{createService.response.body.$.data}}",
  "title": "Database connection pool exhausted",
  "description": "Users getting timeouts on login",
  "severity": "High",
  "correlationKey": "deploy-demo"
}

###

POST {{baseUrl}}/api/v1/incidents/{{createIncident.response.body.$.data}}/assign
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "assigneeId": "{{createUser.response.body.$.data}}"
}

###

POST {{baseUrl}}/api/v1/incidents/{{createIncident.response.body.$.data}}/transitions
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "toStatus": "Acknowledged",
  "note": "On it"
}

###

POST {{baseUrl}}/api/v1/incidents/{{createIncident.response.body.$.data}}/transitions
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "toStatus": "Investigating",
  "note": "Investigating logs"
}

###

POST {{baseUrl}}/api/v1/incidents/{{createIncident.response.body.$.data}}/transitions
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "toStatus": "Mitigated",
  "note": "Scaled pool"
}

###

POST {{baseUrl}}/api/v1/incidents/{{createIncident.response.body.$.data}}/transitions
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "toStatus": "Resolved",
  "note": "Fixed"
}

###

POST {{baseUrl}}/api/v1/incidents/{{createIncident.response.body.$.data}}/transitions
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "toStatus": "Closed",
  "note": "Done"
}

###

POST {{baseUrl}}/api/v1/incidents/{{createIncident.response.body.$.data}}/comments
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "body": "Investigating logs..."
}

###

GET {{baseUrl}}/api/v1/incidents/{{createIncident.response.body.$.data}}/timeline
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###

GET {{baseUrl}}/api/v1/incidents/{{createIncident.response.body.$.data}}/comments
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###
### 12) POSTMORTEMS - create (incident must be resolved/closed), review, publish
# @name createPostmortem
POST {{baseUrl}}/api/v1/incidents/{{createIncident.response.body.$.data}}/postmortem
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "title": "Postmortem: DB pool exhaustion",
  "summary": "Short summary",
  "rootCause": "Connection leak",
  "actionItems": "Fix the leak; add a pool-saturation alert"
}

###

POST {{baseUrl}}/api/v1/postmortems/{{createPostmortem.response.body.$.data.id}}/review
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###

POST {{baseUrl}}/api/v1/postmortems/{{createPostmortem.response.body.$.data.id}}/publish
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###
### 13) API KEYS - create, then use the raw key to ingest an event
# @name createApiKey
POST {{baseUrl}}/api/v1/api-keys
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "name": "ingestion-key",
  "expiresAt": "2027-10-27T00:00:00+00:00"
}

###

GET {{baseUrl}}/api/v1/api-keys?page=1&pageSize=20
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###
### 14) EVENT INGESTION - X-API-Key, not Bearer
POST {{baseUrl}}/api/v1/events
Content-Type: application/json
X-API-Key: {{createApiKey.response.body.$.data.key}}

{
  "service": "API Gateway",
  "environment": "Production",
  "severity": "High",
  "message": "High latency detected"
}

###
### 15) WEBHOOKS - list endpoints and deliveries
# The endpoint itself is registered in step 10, before any incident exists: deliveries are
# staged when an incident event is stored, so a webhook added afterwards hears about nothing.
GET {{baseUrl}}/api/v1/webhooks?page=1&pageSize=20
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###

GET {{baseUrl}}/api/v1/webhooks/deliveries?page=1&pageSize=20
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###
### 16) NOTIFICATIONS, PREFERENCES, ANALYTICS, AUDIT
GET {{baseUrl}}/api/v1/notifications?page=1&pageSize=20
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###

PUT {{baseUrl}}/api/v1/notification-preferences
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "preferences": [
    { "severity": "Critical", "channel": "Email", "enabled": true },
    { "severity": "High", "channel": "Email", "enabled": true },
    { "severity": "Critical", "channel": "InApp", "enabled": true }
  ]
}

###

GET {{baseUrl}}/api/v1/analytics/summary
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###

GET {{baseUrl}}/api/v1/audit-logs?page=1&pageSize=20
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###
### 17) SIGNALR - open the development console (browser, Development only)
# GET {{baseUrl}}/signalr-test
# Sign in with the owner email/password, then create or transition an incident in this
# file: the page should show `notificationCreated` / `incidentUpdated`.

###
### 18) SLA - leave an incident open past its response window, then check violations
# After creating a High incident, either wait for Hangfire's `sla-violation-sweep` (every
# minute) or lower the policy response minutes and wait ≤ 60 seconds.
GET {{baseUrl}}/api/v1/incidents/{{createIncident.response.body.$.data}}
Authorization: Bearer {{login.response.body.$.data.accessToken}}

###
### 19) CHANGE PASSWORD & LOGOUT
# WARNING: this changes the owner password. Update @ownerPassword (or skip) before re-running.
POST {{baseUrl}}/api/v1/auth/change-password
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "currentPassword": "{{ownerPassword}}",
  "newPassword": "NewSup3rSecret!",
  "confirmNewPassword": "NewSup3rSecret!"
}

###

POST {{baseUrl}}/api/v1/auth/logout
Authorization: Bearer {{login.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.$.data.refreshToken}}"
}
